{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "amiga-assembly",
      "request": "launch",
      "name": "FS-UAE Run",
      "stopOnEntry": false,
      "program": "${workspaceFolder}/uae/dh0/demo",
      "remoteProgram": "SYS:demo",
      "emulatorType": "fs-uae",
      "emulatorBin": "${workspaceFolder}/uae/fs-uae-wrapper.sh",
      "emulatorArgs": ["--hard_drive_0=${workspaceFolder}/uae/dh0", "--automatic_input_grab=0", "--warp_mode=0"],
      "preLaunchTask": "amigaassembly: build"
    },
    {
      "type": "amiga-assembly",
      "request": "launch",
      "name": "FS-UAE Debug",
      "stopOnEntry": true,
      "program": "${workspaceFolder}/uae/dh0/demo",
      "remoteProgram": "SYS:demo",
      "emulatorType": "fs-uae",
      "emulatorBin": "${workspaceFolder}/uae/fs-uae-wrapper.sh",
      "emulatorArgs": ["--hard_drive_0=${workspaceFolder}/uae/dh0", "--automatic_input_grab=0", "--warp_mode=0"],
      "preLaunchTask": "amigaassembly: build"
    }
  ]
}
